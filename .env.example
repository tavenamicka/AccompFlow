# Base de données PostgreSQL
DB_USER=accompflow
DB_PASSWORD=changeme_use_a_strong_password_here
DB_NAME=accompflow

# Sécurité JWT (générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=changeme_generate_a_random_secret_key_of_at_least_64_chars

# Compte owner (créé/mis à jour via `docker compose exec accompflow-backend python -m app.scripts.create_admin`)
ADMIN_EMAIL=mickael@accomp-num.tranevat.fr
ADMIN_PASSWORD=changeme_your_secure_password
ADMIN_NAME=Mickaël

# --- Prod uniquement (laisser absent en dev local, les défauts conviennent) ---
# IP sur laquelle Docker publie les ports (jamais 0.0.0.0, contournerait UFW)
# BIND_ADDRESS=192.168.1.23
# FRONTEND_BASE_URL=https://accompflow.tranevat.fr
# ferme /docs, /redoc, /openapi.json
# ENVIRONMENT=production
# active le service de sauvegarde pg_dump quotidien (profil Compose "prod")
# COMPOSE_PROFILES=prod
