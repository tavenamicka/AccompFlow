# Base de données PostgreSQL
DB_USER=accompflow
DB_PASSWORD=changeme_use_a_strong_password_here
DB_NAME=accompflow
DATABASE_URL=postgresql+psycopg://accompflow:changeme@accompflow-db:5432/accompflow

# Sécurité JWT (générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=changeme_generate_a_random_secret_key_of_at_least_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Compte owner (créé/mis à jour via `python -m app.scripts.create_admin`, crée aussi
# l'organisation par défaut si elle n'existe pas encore)
ADMIN_EMAIL=mickael@accomp-num.tranevat.fr
ADMIN_PASSWORD=changeme_your_secure_password
ADMIN_NAME=Mickaël

# Stockage des documents
UPLOAD_DIR=/data/client_documents
MAX_FILE_SIZE=52428800

# Email (relais Postfix -> Brevo local, déjà authentifié pour tranevat.fr)
SMTP_HOST=localhost
SMTP_PORT=25
SENDER_EMAIL=contact@tranevat.fr

# Frontend (pour construire les liens d'invitation)
FRONTEND_BASE_URL=http://localhost:8102

# CORS
CORS_ORIGINS=["http://localhost:8102","http://localhost:3000"]

# production ferme /docs, /redoc, /openapi.json — laisser "development" tant que
# ce prototype n'est pas déployé
ENVIRONMENT=development

TZ=Europe/Paris
